# One account per line. Copy the ltoken_v2 and ltuid_v2 cookies from hoyolab.com.
HOYOLAB_COOKIE="ltoken_v2=v2_xxxxxxxx; ltuid_v2=123456789"

# Games to check in, per account, matching the HOYOLAB_COOKIE lines.
# Codes: gi (Genshin), hsr (Star Rail), zzz (Zenless Zone Zero), hi3 (Honkai 3rd), tot (Tears of Themis)
HOYOLAB_GAMES="gi hsr zzz"

# Optional: language of the reward names in your check-in history.
HOYOLAB_LANG=en-us

# Optional: wait up to this many seconds before starting, so scheduled runs
# do not all hit the API at the same instant.
JITTER_SECONDS=0

# Optional notifications — leave unset to disable.
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# DISCORD_USER_ID=123456789012345678
# TELEGRAM_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
